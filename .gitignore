# =============================================================================
# Personal Expense Tracker — .gitignore
# Stack: Python / FastAPI backend  +  React / Vite / TypeScript frontend
# =============================================================================

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
backend/venv/
backend/.venv/
.venv/
venv/
backend/app/*/__pycache__

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Ruff cache
.ruff_cache/

# Mypy
.mypy_cache/
.dmypy.json

# Type stubs
*.pyi

# ── Database ──────────────────────────────────────────────────────────────────
# The seed copy at backend/expense.db is intentional (Docker init-db uses it
# to populate the named volume on first run). Ignore runtime journal files and
# any stray .db files outside the backend directory.
*.db-journal
*.db-wal
*.db-shm
/expense.db

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
# Keep the example files
!backend/.env.example
!frontend/.env.example

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# npm / pnpm / yarn caches (lock files are committed)
.npm/
.yarn/cache
.pnp.*

# Vitest coverage output
frontend/coverage/

# TypeScript incremental build info
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / temp ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*~
